# Neon PostgreSQL (Drizzle ORM). Neon 대시보드 > Connection string 에서 복사하세요.
DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# 배포된 사이트 주소 (마지막 슬래시 없이). 로컬 개발 시 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 관리자 글쓰기 페이지(/admin) 비밀번호
ADMIN_PASSWORD=change-me

# 관리자 로그인 세션 서명에 사용하는 임의의 긴 문자열 (openssl rand -hex 32 로 생성)
AUTH_SECRET=change-me-too

# 검색엔진 소유 확인 메타태그 값 (선택, 없으면 비워두세요)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
